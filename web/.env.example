# openai 使用 Chat Completions，anthropic 使用 Messages。两种端点均须支持工具调用。
HUIXU_LLM_PROTOCOL=openai
# MiniMax Anthropic 兼容基址示例为 https://api.minimaxi.com/anthropic。
HUIXU_LLM_BASE_URL=
HUIXU_LLM_MODEL=
HUIXU_LLM_API_KEY=
# 可选，使用 Web 根目录之外的 SQLite 文件。
HUIXU_MEMORY_DB=
# 可选，本机账号和会话数据库，路径须位于 Web 根目录之外。
HUIXU_AUTH_DB=
