# 可选的后备模型。工作台「模型设置」保存的模型优先使用。
# openai 使用 Chat Completions，anthropic 使用 Messages。两种端点均须支持工具调用。
HUIXU_LLM_PROTOCOL=openai
# MiniMax 中国兼容接口示例为 https://api.minimax.cn/anthropic，模型填服务商提供的 ID。
HUIXU_LLM_BASE_URL=
HUIXU_LLM_MODEL=
HUIXU_LLM_API_KEY=
# 可选，Anthropic 原生默认 x-api-key，MiniMax 和其他兼容接口默认 bearer。
HUIXU_LLM_KEY_HEADER=
# 可选，使用 Web 根目录之外的 SQLite 文件。
HUIXU_MEMORY_DB=
# 可选，本机账号和会话数据库，路径须位于 Web 根目录之外。
HUIXU_AUTH_DB=
# 可选，至少 32 字符的独立随机邀请码。首位负责人建号后开放注册，填在服务端环境或平台密文配置中。
HUIXU_SIGNUP_CODE=
# 可选，本机模型设置数据库，路径须位于 Web 根目录之外。
HUIXU_MODEL_DB=
# 报名、公开活动快照、凭证、签到与发信记录，路径须位于 Web 根目录之外。
HUIXU_REGISTRATION_DB=
# 参与者可访问的 HTTPS 站点源地址，例如 https://events.example.com。
HUIXU_PUBLIC_ORIGIN=
# 在 Resend 验证发件地址所属域名后配置。密钥仅供服务端读取。
HUIXU_RESEND_API_KEY=
HUIXU_MAIL_FROM=
